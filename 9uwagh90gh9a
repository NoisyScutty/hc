<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>NaturalLife - Sürdürülebilir Yaşam</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
  :root {
    --bg: #f6fbf6;
    --surface: #ffffff;
    --primary: #215c3f;
    --secondary: #84b487;
    --accent: #f4d87c;
    --text: #1d352f;
    --muted: #5f6c64;
    --shadow: 0 18px 60px rgba(33, 92, 63, 0.12);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    font-family: 'Inter', sans-serif;
    background: linear-gradient(180deg, #eef7ec 0%, #f5fbf7 45%, #f8fcfa 100%);
    color: var(--text);
    position: relative;
    overflow-x: hidden;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background: radial-gradient(circle at 10% 15%, rgba(132, 180, 135, 0.22), transparent 16%),
                radial-gradient(circle at 85% 10%, rgba(33, 92, 63, 0.14), transparent 18%),
                radial-gradient(circle at 50% 85%, rgba(244, 216, 124, 0.16), transparent 25%);
    pointer-events: none;
    z-index: -1;
  }

  .particles {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
  }

  .particle {
    position: absolute;
    border-radius: 50%;
    opacity: 0.75;
    animation: drift 16s linear infinite;
  }

  .particle:nth-child(1) {
    width: 16px;
    height: 16px;
    left: 8%;
    top: 22%;
    background: rgba(132, 180, 135, 0.32);
    animation-duration: 18s;
  }

  .particle:nth-child(2) {
    width: 10px;
    height: 10px;
    left: 68%;
    top: 12%;
    background: rgba(244, 216, 124, 0.32);
    animation-duration: 14s;
  }

  .particle:nth-child(3) {
    width: 14px;
    height: 14px;
    left: 30%;
    top: 70%;
    background: rgba(33, 92, 63, 0.22);
    animation-duration: 20s;
  }

  .particle:nth-child(4) {
    width: 12px;
    height: 12px;
    left: 80%;
    top: 55%;
    background: rgba(132, 180, 135, 0.26);
    animation-duration: 12s;
  }

  .particle:nth-child(5) {
    width: 18px;
    height: 18px;
    left: 45%;
    top: 35%;
    background: rgba(33, 92, 63, 0.18);
    animation-duration: 22s;
  }

  @keyframes drift {
    0% { transform: translateY(0) translateX(0); opacity: 0.8; }
    50% { transform: translateY(-20px) translateX(10px); opacity: 1; }
    100% { transform: translateY(0) translateX(-10px); opacity: 0.8; }
  }

  header {
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(16px);
    background: rgba(255, 255, 255, 0.85);
    box-shadow: 0 8px 32px rgba(33, 92, 63, 0.06);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 42px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--primary);
    font-weight: 700;
    font-size: 1.4rem;
  }

  .logo svg {
    width: 42px;
    height: 42px;
  }

  nav {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
  }

  nav a {
    color: var(--text);
    text-decoration: none;
    font-size: 0.98rem;
    font-weight: 600;
    position: relative;
    transition: color 0.25s ease;
  }

  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 100%;
    height: 2px;
    background: var(--secondary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  nav a:hover {
    color: var(--primary);
  }

  nav a:hover::after {
    transform: scaleX(1);
  }

  .header-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn {
    position: relative;
    overflow: hidden;
    border: 2px solid var(--primary);
    border-radius: 28px;
    padding: 12px 22px;
    background: transparent;
    color: var(--primary);
    font-weight: 700;
    cursor: pointer;
    transition: background 0.25s ease, transform 0.25s ease, color 0.25s ease;
  }

  .btn::after {
    content: '';
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.85);
    top: 50%;
    left: 20%;
    transform: translate(-50%, -50%) scale(0.4);
    opacity: 0;
    transition: transform 0.35s ease, opacity 0.35s ease;
  }

  .btn:hover {
    background: var(--secondary);
    color: #ffffff;
    transform: translateY(-2px);
  }

  .btn:hover::after {
    opacity: 1;
    transform: translate(40px, -16px) scale(1);
  }

  .btn.primary {
    background: var(--primary);
    color: #fff;
  }

  .btn.secondary {
    background: rgba(132, 180, 135, 0.12);
  }

  main {
    max-width: 1180px;
    margin: 40px auto 60px;
    padding: 0 22px;
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 1fr);
    gap: 36px;
    align-items: center;
    margin-bottom: 56px;
  }

  .eyebrow {
    display: inline-flex;
    margin-bottom: 16px;
    color: var(--secondary);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.85rem;
  }

  .intro h1 {
    margin: 0;
    font-size: clamp(2.8rem, 4vw, 4.2rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
    color: var(--primary);
  }

  .intro p {
    margin-top: 22px;
    max-width: 720px;
    font-size: 1.08rem;
    line-height: 1.8;
    color: var(--muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 30px;
  }

  .intro-image {
    position: relative;
  }

  .hero-card {
    position: relative;
    min-height: 420px;
    border-radius: 28px;
    padding: 32px;
    background: linear-gradient(180deg, rgba(255,255,255,0.96), rgba(226, 246, 222, 0.96));
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .hero-card::before,
  .hero-card::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    opacity: 0.25;
  }

  .hero-card::before {
    width: 160px;
    height: 160px;
    background: rgba(132, 180, 135, 0.18);
    top: -50px;
    right: -40px;
  }

  .hero-card::after {
    width: 120px;
    height: 120px;
    background: rgba(33, 92, 63, 0.12);
    bottom: -40px;
    left: -40px;
  }

  .hero-tag {
    display: inline-flex;
    padding: 9px 16px;
    border-radius: 999px;
    background: rgba(132, 180, 135, 0.18);
    color: var(--primary);
    font-weight: 700;
    margin-bottom: 24px;
  }

  .hero-card h2 {
    margin: 0 0 18px;
    font-size: 1.8rem;
    color: var(--text);
  }

  .hero-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.75;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 28px;
  }

  .hero-stats div {
    background: #fff;
    border-radius: 18px;
    padding: 18px 20px;
    border: 1px solid rgba(33, 92, 63, 0.08);
  }

  .hero-stats strong {
    display: block;
    font-size: 1.4rem;
    color: var(--primary);
    margin-bottom: 6px;
  }

  .hero-stats span {
    display: block;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .search-section {
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(33, 92, 63, 0.08);
    border-radius: 28px;
    padding: 32px 32px 28px;
    box-shadow: var(--shadow);
    margin-bottom: 56px;
  }

  .search-card p {
    margin: 0 0 18px;
    font-weight: 600;
    color: var(--primary);
    letter-spacing: 0.02em;
  }

  .search-section input[type="search"] {
    width: 100%;
    padding: 16px 20px;
    border-radius: 999px;
    border: 1px solid rgba(33, 92, 63, 0.14);
    font-size: 1rem;
    outline: none;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
    background: #f8fcf8;
  }

  .search-section input[type="search"]:focus {
    border-color: var(--secondary);
    box-shadow: 0 0 0 4px rgba(132, 180, 135, 0.12);
  }

  .alphabet {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }

  .alphabet button {
    border: none;
    padding: 10px 14px;
    border-radius: 999px;
    background: rgba(132, 180, 135, 0.16);
    color: var(--primary);
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.25s ease, background 0.25s ease;
    position: relative;
  }

  .alphabet button::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 999px;
    opacity: 0;
    background: rgba(255, 255, 255, 0.24);
    transition: opacity 0.25s ease;
  }

  .alphabet button:hover {
    transform: translateY(-4px);
    background: var(--secondary);
    color: #fff;
  }

  .alphabet button:hover::before {
    opacity: 1;
  }

  .info-section {
    display: grid;
    grid-template-columns: repeat(3, minmax(260px, 1fr));
    gap: 24px;
  }

  .info-card {
    background: #fff;
    border-radius: 28px;
    padding: 28px 26px;
    box-shadow: var(--shadow);
    border: 1px solid rgba(33, 92, 63, 0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: default;
  }

  .info-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 28px 70px rgba(33, 92, 63, 0.12);
  }

  .icon {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border-radius: 18px;
    margin-bottom: 18px;
    background: linear-gradient(135deg, rgba(132, 180, 135, 0.16), rgba(33, 92, 63, 0.08));
    font-size: 1.35rem;
  }

  .info-card h3 {
    margin: 0 0 14px;
    font-size: 1.2rem;
    color: var(--primary);
  }

  .info-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.75;
  }

  footer {
    padding: 40px 22px;
    background: #215c3f;
    color: #ebf5ea;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
    max-width: 1140px;
    margin: 0 auto 16px;
  }

  footer h3,
  footer h4 {
    margin: 0 0 12px;
    color: #fff;
  }

  footer p {
    margin: 0 0 10px;
    color: rgba(235, 245, 234, 0.83);
    line-height: 1.8;
  }

  .copy {
    margin: 0;
    text-align: center;
    color: rgba(235, 245, 234, 0.72);
    font-size: 0.95rem;
  }

  .modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(17, 31, 21, 0.55);
    backdrop-filter: blur(8px);
    justify-content: center;
    align-items: center;
    padding: 22px;
    z-index: 200;
  }

  .modal.active {
    display: flex;
  }

  .modal-content {
    width: min(420px, 100%);
    background: #fff;
    border-radius: 28px;
    padding: 32px 30px;
    position: relative;
    box-shadow: 0 30px 80px rgba(33, 92, 63, 0.15);
  }

  .modal-close {
    position: absolute;
    right: 18px;
    top: 18px;
    font-size: 1.5rem;
    color: var(--primary);
    cursor: pointer;
  }

  .modal-content h2 {
    margin: 0 0 18px;
    color: var(--primary);
    font-size: 1.7rem;
  }

  .modal-content label {
    display: block;
    margin-top: 18px;
    margin-bottom: 8px;
    color: var(--text);
    font-weight: 600;
  }

  .modal-content input {
    width: 100%;
    border: 1.5px solid rgba(33, 92, 63, 0.12);
    border-radius: 16px;
    padding: 14px 16px;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .modal-content input:focus {
    border-color: var(--secondary);
    box-shadow: 0 0 0 4px rgba(132, 180, 135, 0.12);
  }

  .modal-content button {
    width: 100%;
    margin-top: 24px;
    padding: 14px 16px;
    border: none;
    border-radius: 18px;
    background: var(--primary);
    color: #fff;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.25s ease, background 0.25s ease;
  }

  .modal-content button:hover {
    transform: translateY(-2px);
    background: #17482e;
  }

  @media (max-width: 960px) {
    header {
      padding: 16px 24px;
    }

    .intro {
      grid-template-columns: 1fr;
    }

    .hero-card {
      min-height: auto;
    }

    .info-section {
      grid-template-columns: 1fr;
    }

    .footer-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    header {
      flex-direction: column;
      align-items: stretch;
      gap: 18px;
    }

    nav {
      justify-content: center;
    }

    .header-actions {
      justify-content: center;
    }

    .intro h1 {
      font-size: 2.5rem;
    }

    .search-section,
    .hero-card,
    .info-card {
      border-radius: 24px;
    }
  }
</style>
</head>
<body>
  <div class="particles">
    <span class="particle"></span>
    <span class="particle"></span>
    <span class="particle"></span>
    <span class="particle"></span>
    <span class="particle"></span>
  </div>

  <header>
    <div class="logo">
      <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
        <circle cx="32" cy="32" r="30" fill="#84b487" />
        <path d="M32 10 L24 40 L40 40 Z" fill="#215c3f" />
        <path d="M32 40 L28 60 L36 60 Z" fill="#215c3f" />
      </svg>
      NaturalLife
    </div>
    <nav>
      <a href="#home">Ana Sayfa</a>
      <a href="#features">Özellikler</a>
      <a href="#search">Ara</a>
      <a href="#contact">İletişim</a>
    </nav>
    <div class="header-actions">
      <button class="btn" id="btnLogin">Giriş Yap</button>
      <button class="btn" id="btnRegister">Kayıt Ol</button>
    </div>
  </header>

  <main>
    <section class="intro" id="home">
      <div class="intro-text">
        <p class="eyebrow">Doğaya Saygılı Yaşam</p>
        <h1>Doğal, sürdürülebilir ve modern bir yaşam deneyimi.</h1>
        <p>Tekstil atıklarından iklim dostu alışkanlıklara kadar, daha yeşil bir gelecek için çalışan rehberiniz burada.</p>
        <div class="hero-actions">
          <button class="btn primary" id="heroButton">Hemen Başla</button>
          <button class="btn secondary">Sürdürülebilirlik Rehberi</button>
        </div>
      </div>

      <div class="intro-image">
        <div class="hero-card">
          <div class="hero-tag">Öne Çıkan</div>
          <h2>Yeşil Moda ve Tekstil Geri Dönüşümü</h2>
          <p>Günlük alışkanlıklarınızı küçük değişikliklerle iyileştirin ve daha sürdürülebilir bir yaşam tarzı için ilham alın.</p>
          <div class="hero-stats">
            <div>
              <strong>85%</strong>
              <span>Daha az atık</span>
            </div>
            <div>
              <strong>24/7</strong>
              <span>Destek</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="search-section" id="search">
      <div class="search-card">
        <p>Aradığınız konuya hızlıca ulaşın</p>
        <input type="search" placeholder="Anahtar kelime veya konu ara..." aria-label="Anahtar kelime veya konu ara" />
        <div class="alphabet">
          <button>0-9</button><button>A</button><button>B</button><button>C</button><button>Ç</button><button>D</button><button>E</button><button>F</button><button>G</button><button>H</button><button>İ</button><button>J</button><button>K</button><button>L</button><button>M</button><button>N</button><button>O</button><button>Ö</button><button>P</button><button>R</button><button>S</button><button>T</button><button>U</button><button>Ü</button><button>V</button><button>Y</button><button>Z</button>
        </div>
      </div>
    </section>

    <section class="info-section" id="features">
      <article class="info-card">
        <div class="icon">🍃</div>
        <h3>Tekstil Atıklarını Azaltma</h3>
        <p>Eski kıyafetleri bağışlayın, tekrar kullanın veya geri dönüştürün. Böylece çevreye daha az yük bindirirsiniz.</p>
      </article>
      <article class="info-card">
        <div class="icon">⚡</div>
        <h3>İklim Değişikliği ile Mücadele</h3>
        <p>Enerji verimli yaşam önerileri ve karbon ayak izinizi düşürecek alışkanlıklar ile fark yaratın.</p>
      </article>
      <article class="info-card">
        <div class="icon">🌱</div>
        <h3>Kaynakları Koruma</h3>
        <p>Ağaç dikimi, su tasarrufu ve doğal döngüleri destekleyen basit adımlarla geleceğe yatırım yapın.</p>
      </article>
    </section>
  </main>

  <footer id="contact">
    <div class="footer-grid">
      <div>
        <h3>NaturalLife</h3>
        <p>Doğa dostu yaşam önerileriyle hem kendiniz hem gezegen için daha iyi bir gelecek inşa edin.</p>
      </div>
      <div>
        <h4>İletişim</h4>
        <p>info@naturallife.com</p>
        <p>+90 555 123 45 67</p>
        <p>İstanbul, Türkiye</p>
      </div>
    </div>
    <p class="copy">© 2025 NaturalLife - Doğa ve Sürdürülebilirlik</p>
  </footer>

  <div class="modal" id="loginModal">
    <div class="modal-content">
      <span class="modal-close" id="closeLogin">×</span>
      <h2>Giriş Yap</h2>
      <form>
        <label for="loginEmail">E-posta</label>
        <input type="email" id="loginEmail" placeholder="E-postanızı girin" required />
        <label for="loginPassword">Şifre</label>
        <input type="password" id="loginPassword" placeholder="Şifrenizi girin" required />
        <button type="submit">Giriş Yap</button>
      </form>
    </div>
  </div>

  <div class="modal" id="registerModal">
    <div class="modal-content">
      <span class="modal-close" id="closeRegister">×</span>
      <h2>Kayıt Ol</h2>
      <form>
        <label for="registerEmail">E-posta</label>
        <input type="email" id="registerEmail" placeholder="E-postanızı girin" required />
        <label for="registerPassword">Şifre</label>
        <input type="password" id="registerPassword" placeholder="Şifrenizi girin" required />
        <button type="submit">Kayıt Ol</button>
      </form>
    </div>
  </div>

  <script>
    const loginModal = document.getElementById('loginModal');
    const registerModal = document.getElementById('registerModal');
    const btnLogin = document.getElementById('btnLogin');
    const btnRegister = document.getElementById('btnRegister');
    const closeLogin = document.getElementById('closeLogin');
    const closeRegister = document.getElementById('closeRegister');

    btnLogin.addEventListener('click', () => loginModal.classList.add('active'));
    btnRegister.addEventListener('click', () => registerModal.classList.add('active'));
    closeLogin.addEventListener('click', () => loginModal.classList.remove('active'));
    closeRegister.addEventListener('click', () => registerModal.classList.remove('active'));
    window.addEventListener('click', (event) => {
      if (event.target === loginModal) loginModal.classList.remove('active');
      if (event.target === registerModal) registerModal.classList.remove('active');
    });

    document.querySelectorAll('.alphabet button').forEach((button) => {
      button.addEventListener('mouseenter', () => {
        button.style.transform = 'translateY(-2px) scale(1.05)';
      });
      button.addEventListener('mouseleave', () => {
        button.style.transform = '';
      });
    });
  </script>
</body>
</html>
